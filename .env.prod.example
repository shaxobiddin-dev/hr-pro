# HR-Pro Production Environment Variables
# Copy to .env.prod and configure for your environment
# HECH QACHON bu faylni git'ga commit qilmang!

# ===========================================
# DJANGO SETTINGS
# ===========================================
DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=your-very-long-and-secure-secret-key-minimum-50-characters
DEBUG=False
ALLOWED_HOSTS=hrpro.uz,www.hrpro.uz

# ===========================================
# DATABASE (PostgreSQL)
# ===========================================
DB_NAME=hrpro_prod
DB_USER=hrpro_user
DB_PASSWORD=super-secure-database-password
DB_HOST=db
DB_PORT=5432

# ===========================================
# REDIS
# ===========================================
REDIS_URL=redis://redis:6379/0

# ===========================================
# CELERY
# ===========================================
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ===========================================
# EMAIL (SMTP)
# ===========================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=HR-Pro <noreply@hrpro.uz>

# ===========================================
# SECURITY
# ===========================================
CSRF_TRUSTED_ORIGINS=https://hrpro.uz,https://www.hrpro.uz
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True

# ===========================================
# SENTRY (Error Tracking)
# ===========================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ===========================================
# GUNICORN
# ===========================================
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_LOG_LEVEL=warning

# ===========================================
# HR-PRO SPECIFIC
# ===========================================
MHTM_DEFAULT=1200000
